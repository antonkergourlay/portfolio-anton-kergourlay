# Empêche la lecture des fichiers de configuration et des listes de dossiers
Options -Indexes
<FilesMatch "^(config\.local\.php|config\.example\.php)$">
    Require all denied
</FilesMatch>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
# Fichiers internes (inclus par PHP, jamais appelés directement)
<FilesMatch "^(mail-modeles|menu|social)\.php$">
    Require all denied
</FilesMatch>

# Dossiers et fichiers qui ne doivent jamais être publics (lus uniquement par PHP)
RedirectMatch 404 ^/(\.claude|graphify-out|data|src)(/|$)
<FilesMatch "(\.csv|\.md|skills-lock\.json)$">
    Require all denied
</FilesMatch>

# Page d'erreur 404
ErrorDocument 404 /404.php

# Cache navigateur : les images, polices, CSS et JS ne sont pas retéléchargés à chaque page
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 week"
</IfModule>

# Une seule adresse pour le site : https sans www (évite les doublons pour Google)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteRule ^(.*)$ https://antonkergourlay.fr/$1 [R=301,L]
</IfModule>
